-- Pardes: the user's PDF books (request 28 of docs/DESKTOP_STAGE2.md), the book tree's "הספרים שלי"
-- (features/pdf/MyPdfBooks.kt), written by features/pdf/PdfBookStore.kt: each book's file, kept where the user chose
-- (PdfBookFiles), its title, and where it was last read (the page at the view's top, its pixels above the view, the
-- zoom), so that it opens there again, from the tree or after a restart.
CREATE TABLE IF NOT EXISTS pdf_book (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    path TEXT NOT NULL UNIQUE,
    title TEXT NOT NULL,
    page INTEGER NOT NULL DEFAULT 0,
    pageOffset INTEGER NOT NULL DEFAULT 0,
    zoom REAL NOT NULL DEFAULT 1,
    addedAt INTEGER NOT NULL
);

selectAll:
SELECT * FROM pdf_book ORDER BY title, id;

selectById:
SELECT * FROM pdf_book WHERE id = :id;

selectByPath:
SELECT * FROM pdf_book WHERE path = :path;

insert:
INSERT OR IGNORE INTO pdf_book(path, title, addedAt) VALUES (:path, :title, :addedAt);

updatePlace:
UPDATE pdf_book SET page = :page, pageOffset = :pageOffset, zoom = :zoom WHERE id = :id;

delete:
DELETE FROM pdf_book WHERE id = :id;
