<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- First-run library download (LibraryInstallService): foreground data transfer, kept awake, network checks. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Updating the app from within it (update/AppUpdater): the downloaded APK goes to Android's PackageInstaller. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Lets Android replace Pardes by its own update without asking each time (a normal permission, granted at install). -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <application
        android:name=".ZayitApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zayit">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zayit" />
            </intent-filter>
        </activity>
        <service
            android:name=".data.LibraryInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Moving the library between the phone and a memory card (LibraryMover). -->
        <service
            android:name=".data.LibraryMoveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Incremental library updates (DbDeltaUpdateService): download, apply, re-index in the foreground. -->
        <service
            android:name=".delta.LibraryDeltaService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The app's own update (update/AppUpdater): the APK's download, PackageInstaller's answer, and the new version
             saying it was installed. -->
        <service
            android:name=".update.AppUpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".update.AppUpdateInstallReceiver"
            android:exported="false" />
        <receiver
            android:name=".update.AppUpdatedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Launcher widgets (appwidget/): what the Home's widgets show, as RemoteViews. Not exported: the system's
             widget broadcasts reach them all the same. Off below Android 12 (@bool/appwidget_enabled, with their
             WidgetRefreshReceiver): they are drawn with RemoteViews calls of API 31, so Android 11 does not offer them
             (they would stay on "טוען…"), and ZayitWidgets draws nothing there. -->
        <receiver
            android:name=".appwidget.ZmanimWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_zmanim_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_zmanim_info" />
        </receiver>
        <receiver
            android:name=".appwidget.NextZmanWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_next_zman_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_next_zman_info" />
        </receiver>
        <receiver
            android:name=".appwidget.LuachWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_luach_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_luach_info" />
        </receiver>
        <receiver
            android:name=".appwidget.LimudWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_limud_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_limud_info" />
        </receiver>
        <receiver
            android:name=".appwidget.TempleWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_temple_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_temple_info" />
        </receiver>
        <receiver
            android:name=".appwidget.SearchWidgetProvider"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false"
            android:label="@string/appwidget_search_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_search_info" />
        </receiver>
        <!-- Redraws the widgets at the alarm ZayitWidgets sets (explicit) and when the clock, the time zone or the
             language change. No BOOT_COMPLETED: after a reboot or an update the system sends APPWIDGET_UPDATE, which
             sets the alarm again. -->
        <receiver
            android:name=".appwidget.WidgetRefreshReceiver"
            android:enabled="@bool/appwidget_enabled"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
