<?xml version="1.0" encoding="utf-8"?>
<!-- TempleCountdownWidget's title dot: a radial fire gradient with a light edge (11 dp in the layout). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:endColor="@color/appwidget_temple_dot_end"
        android:gradientRadius="5.5dp"
        android:startColor="@color/appwidget_temple_dot_start"
        android:type="radial" />
    <stroke android:width="1dp" android:color="@color/appwidget_temple_dot_edge" />
</shape>
