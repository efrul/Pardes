<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- values-v27/themes.xml with light system bar icons for the dark window background (values-night/themes.xml,
         for Android 8.0, without android:windowLightNavigationBar). -->
    <style name="Theme.Zayit" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
