<?xml version="1.0" encoding="utf-8"?>
<!-- Pardes for Android 4.4 to 7.1: the main app's id and library folder, its own screens (README.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="auto">

    <!-- Kermit 2.1 declares API 23 for its Android logger, which only calls android.util.Log, and HebrewNumerals
         (com.kdroid.gematria) API 21 for plain Kotlin that calls no Android API (checked: the release dex has no
         reference above API 19 outside guarded code, README.md). -->
    <uses-sdk tools:overrideLibrary="co.touchlab.kermit,co.touchlab.kermit.core,com.kdroid.gematria" />

    <!-- The install from files (ui/InstallActivity.kt) browses the phone's storage and its memory cards: reading them
         needs this permission on Android 4.4 to 7.1 (asked for while the app runs from 6.0). Writing lets a library folder
         copied to the phone be moved into the library folder (a rename) instead of copied; Android 4.4 writes a memory
         card only in the app's own folder whatever the app holds. The library folder itself needs neither. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- The install runs in a foreground service (ui/InstallService.kt) and keeps the CPU awake, as the main app's. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Back is handled in onBackPressed (an open pane, a category level), which Android 4.4 to 7.1 call: predictive
         back (Android 13 and later) is turned off so that a device that installs this edition anyway keeps calling it.
         largeHeap: the desktop search (Lucene) needs room for a search of several words beside the screens' bitmaps,
         which Android 4.4 to 7.1 keep on the Java heap; data/LegacySearch.kt reads the heap it gets. -->
    <application
        android:name=".PardesApp"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pardes">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The desktop's passage links (copy link), as the main app opens them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="zayit" />
            </intent-filter>
        </activity>
        <!-- The main app's launcher activity name, under which the transfer scripts and the docs' adb commands start
             Pardes (am start -n io.github.efrul.pardes/io.github.kdroidfilter.seforimapp.android.MainActivity). -->
        <activity-alias
            android:name="io.github.kdroidfilter.seforimapp.android.MainActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity" />
        <!-- The licence, accepted once before the first Home (the main app's onboarding step). -->
        <activity android:name=".ui.LicenceActivity" />
        <activity android:name=".ui.LibraryActivity" />
        <!-- The find bar's keyboard shrinks the reader rather than covering the text (the main app's imePadding). -->
        <activity
            android:name=".ui.BookActivity"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity android:name=".ui.TocActivity" />
        <activity
            android:name=".ui.SearchActivity"
            android:windowSoftInputMode="stateVisible|adjustResize" />
        <activity android:name=".ui.SettingsActivity" />
        <activity android:name=".ui.TextActivity" />
        <activity
            android:name=".ui.InstallActivity"
            android:launchMode="singleTop" />
        <service
            android:name=".ui.InstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
