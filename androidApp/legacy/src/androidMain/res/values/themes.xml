<?xml version="1.0" encoding="utf-8"?>
<!-- Android 4.4: Holo, without its action bar (the screens draw the main app's title bar, ui/Ui.kt), with the main
     app's grounds and the gold accent where Holo has its blue: the text's selection and the fast scroller's thumb. -->
<resources>
    <style name="Theme.Pardes" parent="android:Theme.Holo.Light.NoActionBar">
        <item name="android:windowBackground">@color/ground_light</item>
        <item name="android:colorBackground">@color/ground_light</item>
        <item name="android:textColorHighlight">@color/gold_selection</item>
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@android:color/transparent</item>
    </style>

    <style name="Theme.Pardes.Dark" parent="android:Theme.Holo.NoActionBar">
        <item name="android:windowBackground">@color/ground_dark</item>
        <item name="android:colorBackground">@color/ground_dark</item>
        <item name="android:textColorHighlight">@color/gold_selection</item>
        <item name="android:fastScrollThumbDrawable">@drawable/fastscroll_thumb</item>
        <item name="android:fastScrollTrackDrawable">@android:color/transparent</item>
    </style>

    <color name="ground_light">#F2F3F5</color>
    <color name="ground_dark">#1E1F22</color>
    <color name="pardes_gold">#BE9117</color>
    <color name="gold_selection">#66BE9117</color>
</resources>
